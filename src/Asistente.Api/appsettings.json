{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseSettings": {
    "Asistente": {
      "Provider": "SqlServer",
      "ConnectionString": "",
      "Schema": "dbo",
      "CommandTimeoutSeconds": 30
    },
    "Tickets": {
      "Provider": "Oracle",
      "AdoDataSource": "",
      "CommandTimeoutSeconds": 15,
      "MaxFilas": 200,
      "Mapeo": {
        "Vista": "VW_ASISTENTE_TICKETS",
        "ColumnaTicketId": "TICKET_ID",
        "ColumnaClienteId": "CLIENTE_ID",
        "ColumnaClienteNombre": "CLIENTE_NOMBRE",
        "ColumnaTitulo": "TITULO",
        "ColumnaEstado": "ESTADO",
        "ColumnaPrioridad": "PRIORIDAD",
        "ColumnaFechaCreacion": "FECHA_CREACION",
        "ColumnaAsignadoA": "ASIGNADO_A"
      }
    }
  },
  "RelojSettings": {
    "ZonaHoraria": "America/Argentina/Buenos_Aires"
  },
  "SwaggerSettings": {
    "ContactName": "Asistente de Registro de Tareas"
  },
  "AuthSettings": {
    "TopeIntentosFallidos": 5,
    "MinutosBloqueo": 15
  }
}
